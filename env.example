# Copy this file to .env and fill in whichever values you actually use.
# Nothing here is required — every feature that reads one of these
# gracefully degrades with an honest "not configured" message if it's
# missing, instead of crashing.
#
# Unlike `setx`, this file is picked up immediately on the next run —
# no fresh terminal window needed.

# ---- Phone bridge (ntfy push notifications) ----
# Pick a private, hard-to-guess topic name and subscribe to the same
# one in the ntfy Android app.
ULTRON_NTFY_TOPIC=Ultron-zxcvb

# ---- Phone bridge authentication ----
# REQUIRED before exposing port 5151 outside your home network (e.g.
# via Tailscale or port forwarding). Without this set, a random token
# is generated every restart, which breaks any bookmarked panel/
# dashboard URL each time. Generate one yourself, e.g. in PowerShell:
#   -join ((48..57)+(97..122)|Get-Random -Count 32|%{[char]$_})
ULTRON_API_TOKEN=9hdmg8znxfbi0qt32vwjo76r1upls54a

# ---- LangGraph agent brain (Mistral API) ----
# Free tier key: https://console.mistral.ai
MISTRAL_API_KEY=
AGENT_MODEL=mistral-small-latest

# ---- Code analyzer (local Ollama, separate from the agent above) ----
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:1b

# ---- Real API tools for the agent ----
# Web search, free tier: https://tavily.com
TAVILY_API_KEY=
# Weather, free tier: https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Math/facts, free tier: https://products.wolframalpha.com/api
WOLFRAM_APP_ID=

# ---- Optional: Claude API for deeper code analysis (paid, no free tier) ----
ANTHROPIC_API_KEY=

# ---- Google Calendar + Gmail ----
# These don't go here — they use credentials.json / token.json files
# in this same folder instead (see calendar_integration.py for setup).
